{
  "name": "vanatome",
  "version": "0.1.0",
  "private": true,
  "description": "Human anatomy visualization product and embeddable React viewer.",
  "license": "MIT",
  "author": "Vanatome contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vixotic/Vanatome.git"
  },
  "bugs": {
    "url": "https://github.com/vixotic/Vanatome/issues"
  },
  "homepage": "https://github.com/vixotic/Vanatome#readme",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run package:build && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "npm run package:build && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test --workspace @vixotic/vanatome-atlas && npm run build && node --test tests/rendered-html.test.mjs tools/anatomy/tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern '**/dist/**' --ignore-pattern .next",
    "package:build": "npm run build --workspace @vixotic/vanatome-react && npm run build --workspace @vixotic/vanatome-atlas",
    "package:check": "npm run check --workspace @vixotic/vanatome-react && npm run check --workspace @vixotic/vanatome-atlas",
    "atlas:stage": "node tools/anatomy/pipeline.mjs stage",
    "atlas:validate": "node tools/anatomy/pipeline.mjs validate",
    "atlas:promote": "node tools/anatomy/pipeline.mjs promote",
    "atlas:release": "node tools/anatomy/release.mjs",
    "atlas:test": "node --test tools/anatomy/tests/*.test.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@vixotic/vanatome-atlas": "^0.1.0",
    "@vixotic/vanatome-react": "^0.1.3",
    "lucide-react": "^1.27.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
