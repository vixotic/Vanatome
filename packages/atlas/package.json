{
  "name": "@vixotic/vanatome-atlas",
  "version": "0.1.0",
  "description": "Versioned human anatomy catalogs and browser loaders for Vanatome.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "ASSET-LICENSE.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.check.json",
    "sync:demo": "node scripts/sync-demo-catalog.mjs",
    "test": "npm run check && npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run test"
  },
  "peerDependencies": {
    "@vixotic/vanatome-react": "^0.1.3"
  },
  "devDependencies": {
    "@vixotic/vanatome-react": "0.1.3",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vixotic/Vanatome.git",
    "directory": "packages/atlas"
  },
  "keywords": [
    "anatomy",
    "atlas",
    "vanatome",
    "z-anatomy",
    "gltf",
    "glb"
  ],
  "engines": {
    "node": ">=22.13.0"
  }
}
